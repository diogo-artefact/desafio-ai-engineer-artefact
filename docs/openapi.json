{
  "openapi": "3.1.0",
  "info": {
    "title": "Empório da Música API",
    "description": "API do assistente de atendimento da Empório da Música (Campo Grande, MS). Combina consultas exatas via SQLAlchemy ORM em SQLite, busca vetorial no manual PDF com Gemini Embeddings, guardrail de entrada System One (Jev), gateways determinísticos de privacidade (LGPD), pedidos por chat (human-in-the-loop) e rate limit sliding-window.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://artefact-api.diogo.sh",
      "description": "Produção (AWS EC2 + Caddy)"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Desenvolvimento local"
    }
  ],
