  "components": {
    "schemas": {
      "Body_upload_csvs_api_knowledge_csvs_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_upload_csvs_api_knowledge_csvs_post"
      },
      "Body_upload_pdf_api_knowledge_pdf_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_pdf_api_knowledge_pdf_post"
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "ID de uma conversa existente. Omitido para criar uma nova conversa."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "Mensagem enviada pelo usuário."
          },
          "enabled_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled Tools",
            "description": "Lista opcional de ferramentas ativas (restrito ao perfil gestor)."
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "CreateSessionRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Título inicial da conversa.",
            "default": "Nova conversa"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "title": "Email",
            "description": "E-mail da conta cadastrada."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password",
            "description": "Senha da conta."
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RegisterRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Nome exibido no atendimento.",
            "default": ""
          },
          "email": {
            "type": "string",
