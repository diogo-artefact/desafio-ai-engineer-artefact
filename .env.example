# Chave da API do Google Gemini (obrigatória para executar o agente)
GEMINI_API_KEY=

# Modelo Gemini utilizado pelo agente PydanticAI
LLM_MODEL=google:gemini-4-hydrogen

# Modelo de embeddings para busca híbrida nas políticas (opcional; há fallback lexical FTS5)
EMBEDDING_MODEL=gemini-embedding-001

# Caminhos locais de dados
RAW_DATA_DIR=data/raw
DATABASE_PATH=data/emporio.db

# Servidor da API FastAPI
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
